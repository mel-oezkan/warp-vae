        "multi_latent_codes=[]\n",
        "\n",
        "save_dir=os.path.join(os.getcwd(),\"multiview_interpolate_latent\")\n",
        "if not os.path.exists(save_dir):\n",
        "    os.makedirs(save_dir,exist_ok=True)\n",
        "\n",
        "start_frame=10\n",
        "end_frame=40\n",
        "\n",
        "with torch.no_grad():\n",
        "    for i in range(start_frame,end_frame):\n",
        "        img=all_images_bench[i]\n",
        "        img=img.to(device=device,dtype=torch.float16)\n",
        "        posterior=vae.encode(img).latent_dist\n",
        "        z=posterior.sample().cpu().float().numpy()\n",
        "\n",
        "\n",
        "        np.savez_compressed(file=f\"{save_dir}/latent_{i:04d}.npz\",latent=z)\n",
        "\n",
        "        del img, posterior, z\n",
        "        torch.cuda.empty_cache()\n",
        "\n",
        "files=sorted(glob.glob(f\"{save_dir}/latent_*.npz\"))\n",
        "\n",
        "\n",
        "for f in files:\n",
        "    data=np.load(f)\n",
        "    multi_latent_codes.append(data[\"latent\"])\n",
        "z_multi=np.stack(multi_latent_codes)\n",
        "print(z_multi.shape)\n",
        "\n",
        "#interpolation\n",
        "\n",
        "spherical_inter_latents=[]\n",
        "num_step_between_frame=4\n",
        "alphas=np.linspace(0,1,num_step_between_frame)\n",
        "for i in range(len(z_multi)-1):\n",
        "    z0=torch.tensor(z_multi[i],dtype=torch.float16).to(device)\n",
        "    z1=torch.tensor(z_multi[i+1],dtype=torch.float16).to(device)\n",
        "    inter= spherical_interpolation(z0,z1,alphas)\n",
        "    for item in iter(inter):\n",
        "\n",
        "        spherical_inter_latents.append(item)\n",
        "\n",
        "\n",
        "\n",
        "#decode\n",
        "decoded_images=[]\n",
        "with torch.no_grad():\n",
        "\n",
