        "from diffusers import AutoencoderKL\n",
        "import glob\n",
        "\n",
        "device= torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "\n",
        "print(f\"Using device:{device}\")\n",
        "\n",
        "vae=AutoencoderKL.from_pretrained(\n",
        "    \"stabilityai/stable-diffusion-2-1-base\",\n",
        "    subfolder=\"vae\",\n",
        "    torch_dtype=torch.float16\n",
        ").to(device).eval()\n",
        "\n",
        "latent_codes=[]\n",
        "\n",
        "save_dir=os.path.join(os.getcwd(),\"latent_batches\")\n",
        "if not os.path.exists(save_dir):\n",
        "    os.makedirs(save_dir,exist_ok=True)\n",
        "\n",
        "with torch.no_grad():\n",
        "    for i, itms in enumerate(tqdm(dl)):\n",
        "        img=itms[\"image\"]\n",
        "        img=img.to(device=device,dtype=torch.float16)\n",
        "        posterior=vae.encode(img).latent_dist\n",
        "        z=posterior.sample().cpu().float()\n",
        "        z_flat=z.flatten(start_dim=1).numpy()\n",
        "\n",
        "        np.savez_compressed(file=f\"{save_dir}/batch_{i:04d}.npz\",latent=z_flat)\n",
        "\n",
        "        del itms, posterior, z\n",
        "        torch.cuda.empty_cache()\n",
        "\n",
        "files=sorted(glob.glob(f\"{save_dir}/batch_*.npz\"))\n",
        "\n",
        "for f in files:\n",
        "    data=np.load(f)\n",
        "    latent_codes.append(data[\"latent\"])\n",
        "latent_codes=np.concatenate(latent_codes,axis=0)\n",
        "print(f'latent_codes shape: {latent_codes.shape}')\n"
      ]
    },
