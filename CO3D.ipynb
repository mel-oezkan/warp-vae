      "source": [
        "import plotly.graph_objects as go\n",
        "import plotly.io as pio\n",
        "points_np = sample['pointcloud'][0].cpu().numpy()\n",
        "points_np = points_np[~np.isnan(points_np).any(axis=1)]\n",
        "points_np = points_np[~np.isinf(points_np).any(axis=1)]\n",
        "\n",
        "\n",
        "center = points_np.mean(axis=0)\n",
        "points_centered = points_np - center\n",
        "max_range = np.max(np.linalg.norm(points_centered, axis=1))\n",
        "points_normalized = points_centered / max_range\n",
        "print(points_normalized)\n",
        "\n",
        "print(\"X range:\", points_normalized[:,0].min(), points_normalized[:,0].max())\n",
        "print(\"Y range:\", points_normalized[:,1].min(), points_normalized[:,1].max())\n",
        "print(\"Z range:\", points_normalized[:,2].min(), points_normalized[:,2].max())\n",
        "\n",
        "points_np = points_normalized\n",
        "\n",
        "\n",
        "N_sample = 7000\n",
        "if points_np.shape[0] > N_sample:\n",
        "    idx = np.random.choice(points_np.shape[0], N_sample, replace=False)\n",
        "    points_np_sample = points_np[idx]\n",
        "else:\n",
        "    points_np_sample = points_np\n",
        "\n",
        "fig = go.Figure(data=[go.Scatter3d(\n",
        "    x=points_np_sample[:,0],\n",
        "    y=points_np_sample[:,1],\n",
        "    z=points_np_sample[:,2],\n",
        "    mode='markers',\n",
        "    marker=dict(\n",
        "        size=3,\n",
        "        color=points_np_sample[:,2],\n",
        "        colorscale='Viridis',\n",
        "        opacity=0.8\n",
        "    )\n",
        ")])\n",
        "fig.update_layout(\n",
        "    scene=dict(\n",
        "        aspectmode='cube',\n",
        "        xaxis=dict(range=[-1,1]),\n",
        "        yaxis=dict(range=[-1,1]),\n",
        "        zaxis=dict(range=[-1,1])\n",
        "    ),\n",
        "    margin=dict(l=0,r=0,b=0,t=0)\n",
        ")\n",
        "\n",
        "\n",
        "pio.renderers.default = \"colab\"\n",
        "fig.show()\n"
      ]
    },
