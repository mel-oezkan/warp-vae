        "def co3d_collate_func(batch):\n",
        "    collated={}\n",
        "    keys=batch[0].keys()\n",
        "    for key in keys:\n",
        "        values=[b[key] for b in batch]\n",
        "        if isinstance(values[0],torch.Tensor):\n",
        "            try:\n",
        "                collated[key]=torch.stack(values)\n",
        "            except:\n",
        "                collated[key]=values\n",
        "\n",
        "        else:\n",
        "            collated[key]=values\n",
        "    return collated\n",
        "\n",
        "\n",
        "print(f'category Apple image num: {len(dataset)}')\n",
        "dataloader=DataLoader(dataset=dataset,\n",
        "                      batch_size=16,\n",
        "                      shuffle=True,\n",
        "                      num_workers=2,\n",
