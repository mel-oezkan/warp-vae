        "def linear_interpolation(z1:torch.Tensor,z2:torch.Tensor,alphas):\n",
        "    return [(1 - a) * z1 + a * z2 for a in alphas]"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "XUicrtUdKRHl"
      },
      "outputs": [],
      "source": [
        "def spherical_interpolation(z1:torch.Tensor,z2:torch.Tensor,alphas):\n",
        "    def calc(t,x1,x2):\n",
        "        x1_norm=x1 / torch.norm(x1)\n",
        "        x2_norm=x2 / torch.norm(x2)\n",
        "\n",
        "        dot=torch.sum(x1_norm * x2_norm)\n",
        "\n",
        "        theta= torch.acos(dot)\n",
        "        sin_theta=torch.sin(theta)\n",
        "        if sin_theta==0:\n",
        "            return (1-t) * x1 + t * x2\n",
        "        return (torch.sin((1- t) *theta)/ sin_theta) * x1 + (torch.sin(t * theta) / sin_theta) *x2\n",
        "\n",
        "    return [ calc(a, z1, z2) for a in alphas]"
      ]
    },
